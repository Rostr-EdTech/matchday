# ---------------------------------------------------------------------------
# Matchday — environment variables
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (local-first SQLite) ------------------------------------------
# prisma/schema.prisma uses provider = "sqlite" — no online service needed to
# run this locally. On Render this same var instead holds a Postgres
# connection string (Render sets it for you via render.yaml's `fromDatabase`
# — you never type one in by hand there); see README's "Deploying to Render"
# section for how the schema's provider itself gets switched for that case.
DATABASE_URL="file:./dev.db"

# Session JWT signing secret — REQUIRED (the app throws if missing; no fallback).
# Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="please-change-this-to-a-long-random-secret"

# Base URL of the app (used to build invite links).
NEXTAUTH_URL="http://localhost:3000"

# Restrict sign-up and athlete emails to one domain (no "@"). Leave unset for
# local dev / a program not ready to commit to this yet — every account-
# creation path stays open otherwise. See src/lib/allowed-email.ts.
# ALLOWED_EMAIL_DOMAIN="myclub.org"

# --- Invite email (optional) -------------------------------------------------
# Gmail SMTP + an App Password, used for the "Send invite links to all"
# button on a team's roster page. Without these, invite LINKS still work —
# a coach just copy/pastes them manually instead of emailing in bulk. These
# can ALSO be set from /admin/settings instead (stored encrypted in the DB,
# no redeploy needed) — that takes precedence over the env vars here if both
# are set.
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
